# Copy to a real Kubernetes secret (do not commit real credentials).
# Prefer:
#   cp secret.example.env secret.local.env
#   # edit secret.local.env, then create the Secret from it
#
# Example service:
#   postgres-rw.postgres.svc.cluster.local:5432
#
# postgres_exporter expects DATA_SOURCE_NAME format:
#   postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require
# Use sslmode=verify-full when a CA is mounted for the monitoring role.

DATA_SOURCE_NAME=postgresql://monitoring:CHANGE_ME@postgres-rw.postgres.svc.cluster.local:5432/postgres?sslmode=require
