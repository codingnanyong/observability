# External Docker postgres-exporter Endpoints (legacy Timescale host).
#
# Do not commit real IPs or hostnames. Copy this file:
#   cp servicemonitor-docker.yaml.example servicemonitor-docker.yaml
# then replace REPLACE_* placeholders before apply.
# servicemonitor-docker.yaml is gitignored.
apiVersion: v1
kind: Service
metadata:
  name: postgres-exporter-docker
  namespace: observability
  labels:
    app.kubernetes.io/name: postgres-exporter-docker
    app.kubernetes.io/part-of: observability
spec:
  clusterIP: None
  ports:
    - name: metrics
      port: 9187
      targetPort: 9187
---
apiVersion: v1
kind: Endpoints
metadata:
  name: postgres-exporter-docker
  namespace: observability
  labels:
    app.kubernetes.io/name: postgres-exporter-docker
    app.kubernetes.io/part-of: observability
subsets:
  - addresses:
      - ip: REPLACE_HOST_IP
        nodeName: REPLACE_NODE_NAME
    ports:
      - name: metrics
        port: 9187
        protocol: TCP
---
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: postgres-exporter-docker
  namespace: observability
  labels:
    release: kube-prometheus-stack
    app.kubernetes.io/name: postgres-exporter-docker
    app.kubernetes.io/part-of: observability
spec:
  namespaceSelector:
    matchNames:
      - observability
  selector:
    matchLabels:
      app.kubernetes.io/name: postgres-exporter-docker
  endpoints:
    - port: metrics
      interval: 15s
      scrapeTimeout: 10s
      path: /metrics
      relabelings:
        - targetLabel: job
          replacement: postgres-exporter-docker
        - targetLabel: instance
          replacement: pg-legacy
        - targetLabel: pg_cluster
          replacement: pg-legacy
        - targetLabel: runtime
          replacement: docker
