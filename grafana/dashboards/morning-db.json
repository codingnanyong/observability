        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(pg_stat_database_numbackends{job=\"$job\",datname!~\"template.*|postgres\"}) / clamp_min(max(pg_settings_max_connections{job=\"$job\"}), 1) * 100) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
