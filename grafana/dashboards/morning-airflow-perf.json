    {
      "id": 3,
      "type": "stat",
      "title": "Scheduler",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_max(count(kube_pod_status_ready{namespace=\"airflow\",pod=~\"airflow-scheduler-.*\",condition=\"true\"}==1), 1) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0,
                "result": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1,
                "result": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "NO DATA",
                  "color": "orange",
                  "index": 2
                }
              }
            }
          ],
          "links": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "text": {
          "titleSize": 13,
          "valueSize": 36
        }
      },
      "description": "Scheduler Pod Ready."
    },
