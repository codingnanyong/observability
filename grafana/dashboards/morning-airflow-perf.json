    {
      "id": 12,
      "type": "table",
      "title": "DAG fail Top (5m)",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (dag_id) (increase(airflow_dagrun_failed_count[5m])) > 0) or topk(15, sum by (dag_id) (increase(airflow_ti_failures[5m])) > 0)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "dag_id": "DAG",
              "Value": "Fails"
            },
            "indexByName": {
              "DAG": 0,
              "Fails": 1
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Fails",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "최근 5분 DAG/Task 실패가 있는 dag_id 상위."
