    {
      "id": 3,
      "type": "stat",
      "title": "Exporter",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(max(up{job=\"postgres-exporter-k8s\"}) >= bool 1) * (max(pg_up{job=\"postgres-exporter-k8s\"}) >= bool 1)",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
