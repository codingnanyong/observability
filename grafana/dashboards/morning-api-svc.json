    {
      "id": 11,
      "type": "table",
      "title": "API endpoints",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "(sum by (handler, method) (rate(http_requests_total{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}[5m])) * on(handler, method) group_left(tag) max by (handler, method, tag) (http_endpoint_info{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"})) or (max by (handler, method, tag) (http_endpoint_info{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}) * 0)"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "(histogram_quantile(0.95, sum by (handler, le) (rate(http_request_duration_seconds_bucket{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}[5m])))) or (max by (handler) (http_endpoint_info{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}) * 0 / 0)"
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "(sum by (handler) (rate(http_requests_total{job=\"$job\",status=~\"5..\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}[5m])) / clamp_min(sum by (handler) (rate(http_requests_total{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}[5m])), 1e-9)) or (max by (handler) (http_endpoint_info{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}) * 0)"
        },
        {
          "refId": "D",
          "format": "table",
          "instant": true,
          "expr": "(sum by (handler) (increase(http_requests_total{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}[5m]))) or (max by (handler) (http_endpoint_info{job=\"$job\",handler!~\"/health|/info|^/$|/api/healthz|.*/health.*|/metrics|.*/docs|.*/redoc|.*/openapi.json\"}) * 0)"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "handler",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true
            },
            "renameByName": {
              "method": "Method",
              "tag": "Tag",
              "handler": "EP",
              "Value #A": "RPS",
              "Value #B": "p95",
              "Value #C": "Error%",
              "Value #D": "Count 5m"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
